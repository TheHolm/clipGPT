# clipGPT configuration (TOML). Copy to ~/.config/clipgpt/config.toml
# (Linux/FreeBSD), ~/Library/Application Support/clipgpt/config.toml
# (macOS) or %APPDATA%\clipgpt\config.toml (Windows).
#
# Every [name] table is a profile. Without -p clipGPT uses [default]; pick
# others with -p NAME or a comma-separated list, -p ocr,default. Each kind
# of clipboard content goes to the LAST listed profile whose `input`
# accepts it. Unknown keys, wrong value types and unknown profiles are
# errors, in every profile of this file, used or not.
#
# Per profile:
#   include = ["a", "b"]  start from these profiles' settings (later ones
#                         win, the profile's own keys win over all of them)
#   clear = ["key", ...]  drop these keys' included values, so the
#                         built-in default applies again
#   a value of ""         is a real empty string (not the same as clear)
# Keys not set anywhere take the built-in default (shown commented out
# below).

# Beep settings shared by the profiles below. input = ["none"] means this
# profile handles nothing itself and cannot be picked with -p; it only
# exists to be included.
[beeps]
input = ["none"]

# Frequency in Hz, played when a response is received and pasted to the
# clipboard, approx. C6.
beep_tone = 1046

# Frequency in Hz, played when an error occurs or a password was found on
# the clipboard, approx. C3.
error_tone = 131

# Duration in ms for the success/error beeps (set to 0 to disable).
beep_duration = 250

[default]
include = ["beeps"]
# `input` is included like every other key, so [default] would get
# ["none"] from [beeps]. Clear it to get the built-in default: every kind
# of content (text, image and any kind added in later versions). Or list
# the kinds, e.g. input = ["text"] or input = ["text", "image"].
clear = ["input"]

# Only "OpenAI" is supported for now (works with Ollama's OpenAI-compatible
# API too).
api_type = "OpenAI"

# OpenAI's real endpoint, or point this at a local Ollama server, e.g.:
# api_url = "http://127.0.0.1:11434/v1/chat/completions"
# Only http and https are accepted. Plain http to anything other than this
# computer (loopback or one of its own addresses) works, but prints a
# warning: the API key and clipboard text then travel unencrypted.
api_url = "https://api.openai.com/v1/chat/completions"

# Optional - leave empty or remove for servers that need no key (e.g. a
# local Ollama). When any profile has a key, this file must not be
# accessible by other users on Linux/FreeBSD/macOS, or clipGPT refuses to
# run:
#   chmod 600 ~/.config/clipgpt/config.toml
api_key = "sk-your-key-here"

# Required in every profile that handles input (here or via include). The
# model name your api_url/api_key combination serves, e.g. gpt-4o-mini for
# OpenAI, or a local model name for Ollama.
model = "gpt-4o-mini"

# Prompt used when the clipboard contains text. Sent as the system message;
# the clipboard text is sent separately as the user message. "\n" is a
# newline in "double-quoted" strings; 'single-quoted' strings take no
# escapes.
prompt_text = "Check spelling and gramma and rewrite following text on pirate speak. Be mean and pushy \n\n"

# Prompt used when the clipboard contains an image (and no text). Sent as
# the system message; the image is sent separately as the user message.
# The default turns a vision model into an OCR engine. The model must
# accept images (e.g. gpt-4o-mini; for Ollama/llama.cpp a vision model such
# as gemma3 or qwen2.5vl) - otherwise the request fails with the error tone.
# OCR-only models (PaddleOCR-VL, GLM-OCR, ...) may want their own prompt.
prompt_image = "You are an OCR engine. Transcribe all text visible in the image exactly as written, in its original language. Do not translate, summarise, correct, or explain it. Keep the reading order and reproduce the layout as Markdown: headings as #, lists as - or 1., tables as Markdown tables, code or monospaced text in ``` blocks. Mark unreadable parts as [illegible]. Ignore pictures, icons and other non-text content. If the image contains no text, reply exactly: [no text found]. Output only the transcription, with no introduction or comments."

# Largest clipboard text (in bytes, UTF-8) that will be sent to the LLM.
# Bigger clipboards are refused with the error tone. Default 65536 (64 KiB).
#max_input_bytes = 65536

# Largest clipboard image (in bytes) that will be sent, both as read from
# the clipboard and after conversion to PNG (WebP, GIF, BMP and TIFF are
# converted; PNG and JPEG are sent as they are). Bigger images are refused
# with the error tone. Default 10485760 (10 MiB).
#max_image_bytes = 10485760

# Follow HTTP redirects from api_url? Default false: any redirect is an
# error. When true, up to 10 hops are followed, each checked like api_url.
# true or false, without quotes.
#allow_redirects = false

# Refuse clipboard text that looks like an API key, token, private key or
# URL with a password (the clipboard is left as it is). Default true. The
# -s / --no-secret-check command line option turns it off for one run.
#secret_check = true

# Longest wait, in whole seconds, for the LLM's answer (from sending the
# request to the end of the response). 0 = no limit. Default 30. Raise it
# for slow local models - loading an Ollama model cold can take longer. The
# --timeout SECONDS command line option overrides it for one run.
#request_timeout = 30

# A second profile for images only, using a local vision model. With
# -p default,ocr clipboard text goes to [default] and images go here.
#[ocr]
#include = ["beeps"]
#input = ["image"]
#api_url = "http://127.0.0.1:11434/v1/chat/completions"
#model = "qwen2.5vl"
#request_timeout = 120
